{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camera-lab.local/schemas/asset.schema.json",
  "title": "ImageAsset",
  "type": "object",
  "required": [
    "id",
    "title",
    "origin",
    "url",
    "sha256",
    "license",
    "licenseUrl",
    "author",
    "width",
    "height",
    "mimeType",
    "canRedistribute",
    "pipelineMode",
    "createdAt",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "enum": ["REMOTE_LICENSED", "USER_IMPORT"] },
    "url": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string" },
    "downloadUrl": { "type": "string" },
    "sha256": { "type": "string", "minLength": 8 },
    "license": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "mimeType": { "type": "string", "minLength": 1 },
    "canRedistribute": { "type": "boolean" },
    "cameraModel": { "type": "string" },
    "pipelineMode": { "type": "string", "enum": ["JPEG_SIMULATION", "RAW_PIPELINE_PRECOMPUTED"] },
    "ghostPairId": { "type": "string" },
    "ghostRole": { "type": "string", "enum": ["REFERENCE", "CURRENT"] },
    "rawStagesDir": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
