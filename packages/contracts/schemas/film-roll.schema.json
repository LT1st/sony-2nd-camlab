{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camera-lab.local/schemas/film-roll.schema.json",
  "title": "FilmRoll",
  "type": "object",
  "required": [
    "id",
    "name",
    "capacity",
    "preset",
    "strictMode",
    "status",
    "frameIds",
    "createdAt",
    "updatedAt",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "capacity": { "type": "integer", "enum": [12, 24, 36] },
    "preset": { "type": "string", "enum": ["CLASSIC_COLOR", "WARM_AMBER", "MONO_SILVER"] },
    "strictMode": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["EMPTY", "LOADED", "SEALED", "DEVELOPING", "DEVELOPED", "ARCHIVED"]
    },
    "frameIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
