{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@camera-lab/contracts": ["./packages/contracts/src/index.ts"],
      "@camera-lab/domain": ["./packages/domain/src/index.ts"],
      "@camera-lab/camera-port": ["./packages/camera-port/src/index.ts"],
      "@camera-lab/adapters-mock": ["./packages/adapters-mock/src/index.ts"],
      "@camera-lab/image-core": ["./packages/image-core/src/index.ts"],
      "@camera-lab/persistence": ["./packages/persistence/src/index.ts"],
      "@camera-lab/diagnostics": ["./packages/diagnostics/src/index.ts"],
      "@camera-lab/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
